'use client';

import React, { useState } from 'react';
import { Loader2 } from 'lucide-react';
import { cn } from '@/lib/utils';
import { useApp } from '@/app/app-context';
import { Permission } from '@/lib/types';

// Etapa 9 do roadmap "Time x Gerencial" — componente único de exportação,
// reutilizado por toda seção de relatório e pelo Dashboard Gerencial.
// Substitui o DisabledExportButton que ReportSection carregava desde o R1.
//
// Um único modelo de dado alimenta os dois formatos: `rows` é sempre valor
// BRUTO (número puro, ISO date) — CSV serializa cru ("dado bruto agregado",
// pra continuar a conta no Excel); PDF aplica `column.format` (a versão
// "bonita" pra reunião). Ver plano da Etapa 9.

export interface ReportExportColumn<T> {
  key: keyof T;
  label: string;
  format?: (value: T[keyof T], row: T) => string; // só usado no PDF
}

export interface ReportExportConfig<T = any> {
  title: string;
  columns: ReportExportColumn<T>[];
  rows: T[];
}

function csvCell(value: unknown): string {
  if (value === null || value === undefined) return '';
  const str = String(value);
  if (/[",\n]/.test(str)) return `"${str.replace(/"/g, '""')}"`;
  return str;
}

function buildCsv<T>(config: ReportExportConfig<T>): string {
  const header = config.columns.map(c => csvCell(c.label)).join(',');
  const lines = config.rows.map(row => config.columns.map(c => csvCell(row[c.key])).join(','));
  // BOM UTF-8 na frente — sem isso o Excel abre acento quebrado.
  return '﻿' + [header, ...lines].join('\r\n');
}

function downloadBlob(blob: Blob, filename: string) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

// Fire-and-forget — nunca bloqueia nem falha o download por causa do log,
// mesma filosofia de lib/audit-log.ts (uma falha aqui não pode atrapalhar
// a ação principal).
function logExport(reportId: string, reportLabel: string, format: 'csv' | 'pdf' | 'xls', filterSummary: string) {
  fetch('/api/reports/export-log', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ reportId, reportLabel, format, filter: filterSummary })
  }).catch(() => {});
}

function slugify(s: string): string {
  return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

export type ExportFormat = 'pdf' | 'xls' | 'csv';

const FORMAT_LABEL: Record<ExportFormat, string> = { pdf: 'PDF', xls: 'XLS', csv: 'CSV' };
const FORMAT_HINT: Record<ExportFormat, string> = {
  pdf: 'PDF — layout de reunião',
  xls: 'XLS — planilha Excel, uma aba por seção',
  csv: 'CSV — dado bruto, para continuar a conta',
};

// Planilha Excel: uma aba por seção, com o valor bruto (número puro), para o Excel recalcular.
async function buildXlsx(sections: ReportExportConfig<any>[]): Promise<Blob> {
  const XLSX = await import('xlsx');
  const wb = XLSX.utils.book_new();
  const usedNames = new Set<string>();
  for (const section of sections) {
    const aoa: unknown[][] = [
      section.columns.map(c => c.label),
      ...section.rows.map(row => section.columns.map(c => {
        const v = row[c.key];
        return v === null || v === undefined ? '' : v;
      })),
    ];
    const sheet = XLSX.utils.aoa_to_sheet(aoa);
    // Nome de aba: até 31 caracteres, sem caracteres proibidos pelo Excel, e sem repetir.
    const base = (section.title.replace(/[\/?*[\]:]/g, ' ').trim().slice(0, 31)) || 'Planilha';
    let name = base;
    for (let n = 2; usedNames.has(name); n++) name = `${base.slice(0, 27)} ${n}`;
    usedNames.add(name);
    XLSX.utils.book_append_sheet(wb, sheet, name);
  }
  const out = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
  return new Blob([out], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
}

// Cores da identidade visual (ver app/globals.css --accent) — mesmo verde
// água do resto do produto, pra o PDF não parecer um documento genérico.
const PDF_ACCENT: [number, number, number] = [15, 166, 148]; // #0FA694
const PDF_INK: [number, number, number] = [30, 41, 59]; // slate-800
const PDF_MUTED: [number, number, number] = [100, 116, 139]; // slate-500
const PDF_ZEBRA: [number, number, number] = [246, 250, 249]; // tingido levemente de verde água

// Monta o PDF de reunião: cabeçalho com o relatório e o filtro, e uma tabela por seção.
// Usado pelo PDF da página inteira e pelo PDF de uma seção (ex.: o ranking).
//
// Reescrito em 2026-10-08 (o motivo de vários PDFs saírem quebrados): o
// código antigo escrevia cada célula com `maxWidth` — o jsPDF QUEBRA a linha
// sozinho quando o texto excede a largura, mas o cursor Y sempre avançava
// uma linha FIXA (13pt), nunca o nº de linhas que o texto realmente ocupou.
// Texto comprido sobrepunha a linha seguinte (e às vezes a seção seguinte).
// Agora cada célula é medida com `splitTextToSize` ANTES de desenhar, a
// altura da linha vira o MAIOR número de linhas entre as colunas daquela
// linha, e só então o cursor avança por aquilo — nunca mais sobrepõe.
async function buildPdf(sections: ReportExportConfig<any>[], reportLabel: string, filterSummary: string) {
  const ready = sections.filter(s => s.rows.length > 0);
  if (ready.length === 0) return null;
  const { jsPDF } = await import('jspdf');
  const doc = new jsPDF({ unit: 'pt', format: 'a4' });
  const marginX = 40;
  const marginTop = 56;
  const pageHeight = doc.internal.pageSize.getHeight();
  const pageWidth = doc.internal.pageSize.getWidth();
  const contentWidth = pageWidth - marginX * 2;
  const footerY = pageHeight - 26;
  let y = marginTop;
  let pageNumber = 1;

  const drawFooter = () => {
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(7.5);
    doc.setTextColor(...PDF_MUTED);
    doc.text('SSX Desk', marginX, footerY);
    doc.text(`Página ${pageNumber}`, pageWidth - marginX, footerY, { align: 'right' });
  };

  const addPage = () => {
    drawFooter();
    doc.addPage();
    pageNumber += 1;
    y = marginTop;
  };

  // Garante espaço pra `height` pt; se não couber, vira página. Devolve
  // true quando a página virou — quem desenha tabela usa isso pra saber se
  // precisa redesenhar o cabeçalho de coluna.
  const ensureSpace = (height: number): boolean => {
    if (y + height > footerY - 10) {
      addPage();
      return true;
    }
    return false;
  };

  const drawReportHeader = () => {
    doc.setFillColor(...PDF_ACCENT);
    doc.rect(0, 0, pageWidth, 6, 'F');
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(17);
    doc.setTextColor(...PDF_INK);
    doc.text(reportLabel, marginX, y);
    y += 20;

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(9);
    doc.setTextColor(...PDF_MUTED);
    const filterLines = doc.splitTextToSize(filterSummary || 'Sem filtros aplicados', contentWidth);
    doc.text(filterLines, marginX, y);
    y += filterLines.length * 12;
    doc.text(`Gerado em ${new Date().toLocaleString('pt-BR')}`, marginX, y);
    y += 16;
    doc.setDrawColor(...PDF_ACCENT);
    doc.setLineWidth(1.2);
    doc.line(marginX, y, pageWidth - marginX, y);
    doc.setLineWidth(0.5);
    y += 26;
  };

  drawReportHeader();

  const LINE_HEIGHT = 12;
  const ROW_PADDING = 6;
  const HEADER_HEIGHT = 20;

  for (const section of ready) {
    const colWidth = contentWidth / section.columns.length;

    const drawSectionTitle = () => {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(11.5);
      doc.setTextColor(...PDF_ACCENT);
      doc.text(section.title.toUpperCase(), marginX, y);
      y += 18;
    };

    const drawColumnHeader = () => {
      doc.setFillColor(...PDF_ACCENT);
      doc.rect(marginX, y - 13, contentWidth, HEADER_HEIGHT, 'F');
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(8);
      doc.setTextColor(255, 255, 255);
      section.columns.forEach((col, i) => doc.text(col.label, marginX + i * colWidth + 5, y, { maxWidth: colWidth - 8 }));
      y += HEADER_HEIGHT - 4;
    };

    ensureSpace(HEADER_HEIGHT + 24);
    drawSectionTitle();
    drawColumnHeader();

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(8);

    section.rows.forEach((row, rowIndex) => {
      // Cada célula pode quebrar em N linhas — a linha da TABELA usa a maior
      // delas, e só então o cursor avança (é exatamente o que faltava antes).
      const cellLines = section.columns.map(col => {
        const raw = row[col.key];
        const text = col.format ? col.format(raw, row) : (raw === null || raw === undefined ? '—' : String(raw));
        return doc.splitTextToSize(text, colWidth - 8) as string[];
      });
      const maxLines = Math.max(1, ...cellLines.map(l => l.length));
      const rowHeight = maxLines * LINE_HEIGHT + ROW_PADDING;

      const quebrouPagina = ensureSpace(rowHeight);
      if (quebrouPagina) drawColumnHeader();

      if (rowIndex % 2 === 1) {
        doc.setFillColor(...PDF_ZEBRA);
        doc.rect(marginX, y - 9, contentWidth, rowHeight, 'F');
      }

      doc.setTextColor(...PDF_INK);
      cellLines.forEach((lines, i) => {
        doc.text(lines, marginX + i * colWidth + 5, y, { maxWidth: colWidth - 8 });
      });
      y += rowHeight;
    });

    y += 20;
  }

  drawFooter();
  return doc;
}

interface ExportAsMenuProps {
  sections: ReportExportConfig<any>[]; // uma seção (botão da tabela) ou a página inteira
  formats: ExportFormat[];
  reportId: string;
  reportLabel: string;
  filterSummary: string;
  fileBase?: string; // nome do arquivo sem extensão
}

// "Exportar como:" + um botão por formato. CSV só faz sentido para uma seção (um arquivo por tabela).
export function ExportAsMenu({ sections, formats, reportId, reportLabel, filterSummary, fileBase }: ExportAsMenuProps) {
  const { hasPermission } = useApp();
  const allowed = hasPermission(Permission.REPORTS_EXPORT);
  const [busy, setBusy] = useState<ExportFormat | null>(null);
  const hasData = sections.some(s => s.rows.length > 0);
  const base = fileBase ?? slugify(reportId);

  const run = async (format: ExportFormat) => {
    if (!hasData) return;
    setBusy(format);
    try {
      if (format === 'csv') {
        const section = sections[0];
        downloadBlob(new Blob([buildCsv(section)], { type: 'text/csv;charset=utf-8' }), `${base}.csv`);
      } else if (format === 'xls') {
        downloadBlob(await buildXlsx(sections), `${base}.xlsx`);
      } else {
        const doc = await buildPdf(sections, reportLabel, filterSummary);
        if (!doc) return;
        doc.save(`${base}.pdf`);
      }
      logExport(reportId, reportLabel, format, filterSummary);
    } finally {
      setBusy(null);
    }
  };

  const label = <span className="text-[10px] font-bold uppercase tracking-widest text-[var(--text-tertiary)]">Exportar como:</span>;

  if (!allowed) {
    return (
      <div className="inline-flex items-center gap-1.5">
        {label}
        {formats.map(f => (
          <button key={f} disabled title="Sem permissão para exportar"
            className="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest border border-[var(--border-default)] text-[var(--text-tertiary)] opacity-50 cursor-not-allowed">
            {FORMAT_LABEL[f]}
          </button>
        ))}
      </div>
    );
  }

  return (
    <div className="inline-flex flex-wrap items-center gap-1.5" role="group" aria-label="Exportar como">
      {label}
      {formats.map(f => {
        const disabled = !hasData || busy !== null;
        return (
          <button key={f} type="button" onClick={() => run(f)} disabled={disabled} title={FORMAT_HINT[f]}
            className={cn(
              "inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest transition-colors",
              "border border-[var(--border-default)] text-[var(--text-secondary)] hover:border-[var(--accent)]/40 hover:text-[var(--accent-text)]",
              disabled && "opacity-50 cursor-not-allowed"
            )}>
            {busy === f ? <Loader2 size={12} className="animate-spin" /> : null}
            {FORMAT_LABEL[f]}
          </button>
        );
      })}
    </div>
  );
}

interface SectionExportButtonProps<T> {
  config: ReportExportConfig<T> | null; // null enquanto a seção ainda carrega
  reportId: string;
  reportLabel: string;
  filterSummary: string;
}

// Exportação de uma seção: CSV, XLS e PDF.
export function SectionExportButton<T>({ config, reportId, reportLabel, filterSummary }: SectionExportButtonProps<T>) {
  return (
    <ExportAsMenu
      sections={config ? [config as ReportExportConfig<any>] : []}
      formats={['pdf', 'xls', 'csv']}
      reportId={reportId}
      reportLabel={reportLabel}
      filterSummary={filterSummary}
      fileBase={config ? `${slugify(reportId)}_${slugify(config.title)}` : undefined}
    />
  );
}

interface PageExportPdfButtonProps {
  sections: ReportExportConfig<any>[];
  reportId: string;
  reportLabel: string;
  filterSummary: string;
}

// Exportação da página inteira: PDF e XLS (uma aba por seção). CSV fica por seção.
export function PageExportPdfButton({ sections, reportId, reportLabel, filterSummary }: PageExportPdfButtonProps) {
  return (
    <ExportAsMenu
      sections={sections}
      formats={['pdf', 'xls']}
      reportId={reportId}
      reportLabel={reportLabel}
      filterSummary={filterSummary}
    />
  );
}
