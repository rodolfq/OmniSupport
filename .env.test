# Ambiente do servidor de testes automatizados (Playwright). NUNCA aponta pro
# banco real — só o banco descartável ssx_test dentro do container ssx-pg-dev
# (porta 5433). Ver tests/README.md antes de mexer aqui.
#
# tests/start-test-server.js recusa subir se DATABASE_URL não bater com o
# padrão esperado (localhost:5433/ssx_test) — não é só convenção, é travado em
# código, mas o valor abaixo é a fonte de verdade.
DATABASE_URL=postgresql://postgres:devpass@localhost:5433/ssx_test

# Segredo próprio do ambiente de teste, sem relação com o JWT_SECRET real.
JWT_SECRET=test-only-jwt-secret-nao-usar-em-producao

NODE_ENV=test
PORT=3100
NEXT_PUBLIC_APP_URL=http://localhost:3100

# SERVICE_ROLE=frontend desliga os schedulers e a reconexão do WhatsApp no
# boot (ver instrumentation-node.ts) — o servidor de teste não deve tentar
# conectar WhatsApp real nem rodar job de fundo nenhum.
SERVICE_ROLE=frontend

# Anexo de teste fica isolado da pasta usada em desenvolvimento/produção.
ATTACHMENTS_DIR=./tests/.tmp/attachments

# Integrações externas pagas/com credencial ficam desligadas no ambiente de
# teste — nenhum teste deve depender de Groq, transcrição, embeddings, Bitrix24,
# Google Agenda ou Web Push de verdade.
ENABLE_AUDIO_TRANSCRIPTION=false
NEXT_PUBLIC_ENABLE_AUDIO_TRANSCRIPTION=false
ENABLE_AI_EMBEDDINGS=false
ENABLE_DISSATISFACTION_DETECTOR=false
